{
  "name": "@shuyuncong/vue-hierarchy",
  "version": "2.0.0-alpha.1",
  "description": "Vue 3 and TypeScript framework for editable hierarchy, genealogy, permission, and relationship visualizations",
  "author": "shuyuncong",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/vue-hierarchy.cjs",
  "module": "dist/vue-hierarchy.js",
  "types": "dist/index.d.ts",
  "style": "dist/style.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/vue-hierarchy.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.cts",
        "default": "./dist/vue-hierarchy.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "build": "npm run typecheck && vite build --config vite.lib.config.mts && node scripts/fix-declarations.mjs",
    "build:demo": "npm run typecheck && vite build",
    "build:demo:test": "vite build --mode test",
    "preview:demo": "vite preview",
    "test:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm test && npm run benchmark && npm run build && npm run build:demo && npm run test:package",
    "prepack": "npm run build",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist/",
    "dist-cjs/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuyuncong/vue-org-tree.git"
  },
  "bugs": {
    "url": "https://github.com/shuyuncong/vue-org-tree/issues"
  },
  "homepage": "https://shuyuncong.github.io/vue-org-tree/",
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "hierarchy",
    "genealogy",
    "organization-chart",
    "permission-tree",
    "graph"
  ],
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
