{
  "name": "tapn-org-tree",
  "version": "1.0.0",
  "description": "A customizable organization tree component for Vue 2",
  "author": "shuyuncong",
  "license": "MIT",
  "private": false,
  "main": "dist/vue-org-tree.umd.js",
  "module": "dist/vue-org-tree.es.mjs",
  "style": "dist/style.css",
  "exports": {
    ".": {
      "import": "./dist/vue-org-tree.es.mjs",
      "require": "./dist/vue-org-tree.umd.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "build": "vite build --config vite.lib.config.mjs",
    "build:demo": "vite build",
    "build:demo:test": "vite build --mode test",
    "preview:demo": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "verify": "npm test && npm run build && npm run build:demo && npm run test:package",
    "prepack": "npm run build"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuyuncong/vue-org-tree.git"
  },
  "bugs": {
    "url": "https://github.com/shuyuncong/vue-org-tree/issues"
  },
  "homepage": "https://shuyuncong.github.io/vue-org-tree/docs/#/demo",
  "keywords": [
    "vue",
    "vue2",
    "organization-chart",
    "org-tree",
    "tree"
  ],
  "sideEffects": [
    "*.css",
    "*.less",
    "*.vue"
  ],
  "peerDependencies": {
    "vue": "^2.7.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vue/test-utils": "^2.4.11",
    "html2canvas": "^1.4.1",
    "jsdom": "^30.0.1",
    "less": "^4.2.0",
    "panzoom": "^9.4.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "3.5.41",
    "vue-router": "^5.2.0",
    "vue-template-compiler": "2.7.16"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ]
}
